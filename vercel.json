{
  "buildCommand": "echo 'No build needed'",
  "devCommand": "npx serve . -l $PORT",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|ico|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.baustellen-timelapse-leipzig.de"
        }
      ],
      "destination": "https://baustellen-timelapse-leipzig.de/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.baustellen-timelapse-leipzig.de"
        }
      ],
      "destination": "https://baustellen-timelapse-leipzig.de/:path*",
      "permanent": true
    },
    {
      "source": "/public/Instalation/:file",
      "destination": "/public/installation/:file",
      "permanent": true
    }
  ]
}
